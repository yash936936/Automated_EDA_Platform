# Redis / Postgres (match docker-compose.yml, or your Redis Cloud database)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false   # set true for most managed Redis providers, incl. Redis Cloud
PGHOST=127.0.0.1
# docker-compose.yml maps container 5432 -> host 5433, deliberately
# non-default so it never collides with a native/local Postgres install also
# listening on 5432. Do NOT change this to 5432 unless you also change
# docker-compose.yml's port mapping.
PGPORT=5433
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=eda_platform

# Object storage (S3-compatible). Local dev and production intentionally
# point at two different backends through these same S3_* vars -- the code
# in storage.ts/storage.py never forks on which one is live, see D-013/14/15
# in docs/decisions.md.
#
# DEV (default below): a local SeaweedFS instance via docker-compose.yml.
# Its S3 gateway doesn't enforce these credentials in single-node dev mode
# (no identity config loaded), but the AWS SDKs still require *some*
# non-empty access key/secret to sign requests -- any string works here.
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=devkey
S3_SECRET_KEY=devsecret
S3_BUCKET=eda-platform-datasets
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
#
# PRODUCTION: self-hosted SeaweedFS (D-016, supersedes D-015's Cloudflare R2).
# Same software as dev, but it MUST NOT run the way dev does: dev mode has no
# S3 identities configured, so anyone who can reach the port can read/write
# every bucket. In production:
#   1. Start the S3 gateway with an identity config (-s3.config=/etc/seaweedfs/s3.json)
#      defining an access key/secret scoped to this one bucket, and put the
#      same values in S3_ACCESS_KEY / S3_SECRET_KEY below.
#   2. Put TLS in front of it (reverse proxy) and do not expose 8333/9333
#      publicly -- only the API gateway and agent worker should reach it.
#   3. Plan durability yourself: volume replication (e.g. -defaultReplication)
#      and off-host backups. Nothing here replicates data for you.
#   S3_ENDPOINT=https://<your-seaweedfs-host>
#   S3_ACCESS_KEY=<key from s3.json>
#   S3_SECRET_KEY=<secret from s3.json>
#   S3_REGION=auto
#   S3_FORCE_PATH_STYLE=true   # SeaweedFS needs path-style, unlike AWS S3/R2

# One key per agent -- see docs/architecture.md and services/agent-worker/agent_worker/llm/
LLM_PROVIDER=fake   # fake | gemini
GEMINI_API_KEY_DISCOVERY=
GEMINI_API_KEY_EDA_CLEAN=
GEMINI_API_KEY_RAG_SUMMARY=
GEMINI_API_KEY_REPORT_GEN=
GEMINI_API_KEY_EXTRAS=

# OpenTelemetry -- both the API and the worker export traces here as OTLP/HTTP.
# docker-compose.yml's jaeger service listens on this by default; view traces
# at http://localhost:16687 (UI port is 16687, not Jaeger's usual 16686, in
# case you already have a separate Jaeger instance running for something else).
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Set true to also print every span to stdout -- useful for a quick sanity
# check without opening the Jaeger UI (e.g. reading CI logs).
OTEL_DEBUG=false

# --- Phase 1.2: Kaggle discovery (Agent 1) ---
# Generate at https://www.kaggle.com/settings/api ("Generate New Token").
# NOTE: this is ONE server-wide Kaggle account shared by every user of the
# platform -- see docs/decisions.md D-017 for the ToS/rate-limit implications.
KAGGLE_API_TOKEN=
# Refuse to import any single Kaggle file larger than this.
KAGGLE_MAX_IMPORT_MB=1024
# Search-result cache TTL (results built without LLM expansion use 1h regardless).
DISCOVERY_CACHE_TTL_HOURS=24
# Concurrent jobs on the agent.discovery queue (per-agent cap, not per-key).
DISCOVERY_CONCURRENCY=2

# --- Phase 1.3: PII pre-scan ---
# Max rows examined per dataset (rows beyond this are counted but not scanned;
# the dataset records pii_truncated=true so a partial scan is never mistaken for a full one).
PII_MAX_ROWS=500000
